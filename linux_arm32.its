/dts-v1/;

/ {
	description = "Image file for the QorIQ ARM 32b Linux Kernel";
	#address-cells = <1>;

	images {
		kernel-v7 {
			description = "ARM32 Linux kernel";
			data = /incbin/("./arch/arm/boot/zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x80008000>;
			entry = <0x80008000>;
		};

		ls1043a-rdb-dtb {
			description = "ls1043ardb-dtb";
			data = /incbin/("./arch/arm/boot/dts/fsl-ls1043a-rdb-sdk.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x90000000>;
		};

		ls1046a-rdb-dtb {
			description = "ls1046ardb-dtb";
			data = /incbin/("./arch/arm/boot/dts/fsl-ls1046a-rdb-sdk.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x90000000>;
		};
	};

	configurations {
		ls1043a-rdb {
			description = "config for ls1043ardb";
			kernel = "kernel-v7";
			fdt = "ls1043a-rdb-dtb";
		};

		ls1046a-rdb {
			description = "config for ls1046ardb";
			kernel = "kernel-v7";
			fdt = "ls1046a-rdb-dtb";
		};
	};
};
