/dts-v1/;

/ {
        description = "Kernel fitImage for QorIQ SDK (FSL Reference Distro)/6.6.23+git/ls1046afrwy";
        #address-cells = <1>;

        images {
                kernel-1 {
                        description = "Linux kernel";
                        data = /incbin/("arch/arm64/boot/Image.gz");
                        type = "kernel";
                        arch = "arm64";
                        os = "linux";
                        compression = "gzip";
                        load = <0x80080000>;
                        entry = <0x80080000>;
                        hash-1 {
                                algo = "sha256";
                        };
                };
                fdt-fsl-ls1046a-frwy-sdk.dtb {
                        description = "Flattened Device Tree blob";
                        data = /incbin/("arch/arm64/boot/dts/freescale/fsl-ls1046a-frwy-sdk.dtb");
                        type = "flat_dt";
                        arch = "arm64";
                        compression = "none";
                        load = <0x90000000>;
                        hash-1 {
                                algo = "sha256";
                        };
                };
                fdt-fsl-ls1046a-frwy-usdpaa.dtb {
                        description = "Flattened Device Tree blob";
                        data = /incbin/("arch/arm64/boot/dts/freescale/fsl-ls1046a-frwy-usdpaa.dtb");
                        type = "flat_dt";
                        arch = "arm64";
                        compression = "none";
                        load = <0x90000000>;
                        hash-1 {
                                algo = "sha256";
                        };
                };
                fdt-fsl-ls1046a-frwy.dtb {
                        description = "Flattened Device Tree blob";
                        data = /incbin/("arch/arm64/boot/dts/freescale/fsl-ls1046a-frwy.dtb");
                        type = "flat_dt";
                        arch = "arm64";
                        compression = "none";
                        load = <0x90000000>;
                        hash-1 {
                                algo = "sha256";
                        };
                };
	};

        configurations {
                default = "conf-fsl-ls1046a-frwy-sdk.dtb";
                conf-fsl-ls1046a-frwy-sdk.dtb {
                        description = "1 Linux kernel, FDT blob";
                        
                        kernel = "kernel-1";
                        fdt = "fdt-fsl-ls1046a-frwy-sdk.dtb";
                        
                        
                        
                        hash-1 {
                                algo = "sha256";
                        };
                };
                
                conf-fsl-ls1046a-frwy-usdpaa.dtb {
                        description = "0 Linux kernel, FDT blob";
                        
                        kernel = "kernel-1";
                        fdt = "fdt-fsl-ls1046a-frwy-usdpaa.dtb";
                        
                        
                        
                        hash-1 {
                                algo = "sha256";
                        };
                };
                
                conf-fsl-ls1046a-frwy.dtb {
                        description = "0 Linux kernel, FDT blob";
                        
                        kernel = "kernel-1";
                        fdt = "fdt-fsl-ls1046a-frwy.dtb";
                        
                        
                        
                        hash-1 {
                                algo = "sha256";
                        };
                };
	};
};
